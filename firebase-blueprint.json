{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Compte utilisateur TalaMbongo avec profil, rôle, pays, devise, statut d'abonnement et compteurs d'activité agrégés (aucun détail de dépense personnelle exposé).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "country": { "type": "string", "minLength": 1, "maxLength": 80 },
        "currency": { "type": "string", "enum": ["XOF", "XAF", "CDF", "EUR"] },
        "role": { "type": "string", "enum": ["USER", "ADMIN"] },
        "subscriptionStatus": { "type": "string", "enum": ["trial", "active", "expired", "renewed", "cancelled"] },
        "subscriptionType": { "type": "string", "enum": ["free_trial", "monthly", "quarterly"] },
        "subscriptionStartAt": { "type": "string", "maxLength": 40 },
        "subscriptionEndAt": { "type": "string", "maxLength": 40 },
        "subscriptionEndAtTs": { "type": "string", "format": "date-time" },
        "lastConfirmedSubscriptionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "trialDaysLeft": { "type": "number" },
        "trialStartedAt": { "type": "string", "format": "date-time" },
        "trialEndsAt": { "type": "string", "format": "date-time" },
        "hasUsedFreeTrial": { "type": "boolean" },
        "mainGoal": { "type": "string", "maxLength": 150 },
        "trackingFrequency": { "type": "string", "maxLength": 80 },
        "onboardingCompleted": { "type": "boolean" },
        "expensesCount": { "type": "number" },
        "reportsViewedCount": { "type": "number" },
        "pdfExportsCount": { "type": "number" },
        "referredByPartnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referredByCode": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "referralSource": { "type": "string", "enum": ["link", "manual"] },
        "referralSessionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referralAttributedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "name",
        "email",
        "country",
        "currency",
        "role",
        "subscriptionStatus",
        "subscriptionType",
        "onboardingCompleted",
        "expensesCount",
        "reportsViewedCount",
        "pdfExportsCount",
        "createdAt",
        "lastActiveAt",
        "updatedAt"
      ]
    },
    "UserExpense": {
      "title": "UserExpense",
      "description": "Dépense personnelle privée appartenant exclusivement à son propriétaire.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["XOF", "XAF", "CDF", "EUR"] },
        "category": { "type": "string", "minLength": 1, "maxLength": 50 },
        "moment": { "type": "string", "enum": ["Matin", "Après-midi", "Soir"] },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "note": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "amount", "currency", "category", "moment", "date", "createdAt"]
    },
    "SubscriptionRecord": {
      "title": "SubscriptionRecord",
      "description": "Historique des abonnements et paiements confirmés, en attente ou échoués.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "country": { "type": "string", "minLength": 1, "maxLength": 80 },
        "planType": { "type": "string", "enum": ["free_trial", "monthly", "quarterly"] },
        "status": { "type": "string", "enum": ["trial", "active", "expired", "renewed", "cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["confirmed", "pending", "failed", "none"] },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["XOF", "XAF", "CDF", "EUR"] },
        "amountXof": { "type": "number" },
        "startDate": { "type": "string", "maxLength": 40 },
        "endDate": { "type": "string", "maxLength": 40 },
        "endAtTs": { "type": "string", "format": "date-time" },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "country",
        "planType",
        "status",
        "paymentStatus",
        "amount",
        "currency",
        "amountXof",
        "startDate",
        "endDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRegistryEntry": {
      "title": "AdminRegistryEntry",
      "description": "Registre sécurisé des comptes autorisés à accéder au dashboard administrateur.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "grantedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "grantedBy", "createdAt"]
    },
    "AdminStatsSnapshot": {
      "title": "AdminStatsSnapshot",
      "description": "Agrégations globales anonymisées et paramètres du dashboard administrateur.",
      "type": "object",
      "properties": {
        "totalUsers": { "type": "number" },
        "activeUsers30d": { "type": "number" },
        "paidUsers": { "type": "number" },
        "freeUsers": { "type": "number" },
        "totalRevenueXof": { "type": "number" },
        "countriesCount": { "type": "number" },
        "totalExpensesLogged": { "type": "number" },
        "totalReportsViewed": { "type": "number" },
        "totalPdfExports": { "type": "number" },
        "usersWithExpenses": { "type": "number" },
        "activeActivityThresholdDays": { "type": "number" },
        "defaultAdminCurrency": { "type": "string", "enum": ["XOF", "XAF", "CDF", "EUR"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["updatedAt"]
    },
    "Partner": {
      "title": "Partner",
      "description": "Partenaire influenceur ou affilié TalaMbongo (lecture et gestion strictement réservées aux administrateurs).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "channelName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "socialNetwork": { "type": "string", "minLength": 1, "maxLength": 60 },
        "contactInfo": { "type": "string", "minLength": 1, "maxLength": 200 },
        "code": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "referralLink": { "type": "string", "minLength": 1, "maxLength": 300 },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "fixedAdFeeXof": { "type": "number" },
        "commissionPerUserXof": { "type": "number" },
        "commissionType": { "type": "string", "enum": ["first_payment_only"] },
        "status": { "type": "string", "enum": ["active", "suspended", "disabled"] },
        "notes": { "type": "string", "maxLength": 500 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "name",
        "channelName",
        "socialNetwork",
        "contactInfo",
        "code",
        "referralLink",
        "startDate",
        "endDate",
        "fixedAdFeeXof",
        "commissionPerUserXof",
        "commissionType",
        "status",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "PartnerLink": {
      "title": "PartnerLink",
      "description": "Index public minimal sans données personnelles permettant de vérifier la validité et l'expiration d'un code de parrainage.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "partnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["active", "suspended", "disabled"] },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "commissionPerUserXof": { "type": "number" },
        "commissionType": { "type": "string", "enum": ["first_payment_only"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "code",
        "partnerId",
        "status",
        "startDate",
        "endDate",
        "commissionPerUserXof",
        "commissionType",
        "updatedAt"
      ]
    },
    "PartnerClick": {
      "title": "PartnerClick",
      "description": "Journal des clics sur un lien de parrainage actif et valide.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "sessionToken": { "type": "string", "minLength": 1, "maxLength": 128 },
        "landingPath": { "type": "string", "minLength": 1, "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "partnerId", "code", "sessionToken", "landingPath", "createdAt"]
    },
    "ReferralSession": {
      "title": "ReferralSession",
      "description": "Attribution temporaire enregistrée en base pendant le parcours d'inscription.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "clickId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["pending", "consumed"] },
        "usedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "partnerId", "code", "clickId", "status", "createdAt", "updatedAt"]
    },
    "PartnerCommission": {
      "title": "PartnerCommission",
      "description": "Commission partenaire unique déclenchée sur le premier paiement confirmé d'un utilisateur parrainé.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referralCode": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "anonymizedUserRef": { "type": "string", "minLength": 4, "maxLength": 40 },
        "subscriptionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planType": { "type": "string", "enum": ["monthly", "quarterly"] },
        "paymentAmountXof": { "type": "number" },
        "amountXof": { "type": "number" },
        "commissionType": { "type": "string", "enum": ["first_payment_only"] },
        "status": { "type": "string", "enum": ["pending", "paid"] },
        "paidAt": { "type": "string", "format": "date-time" },
        "payoutReference": { "type": "string", "maxLength": 120 },
        "payoutNote": { "type": "string", "maxLength": 300 },
        "paidByAdminUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "partnerId",
        "referralCode",
        "userId",
        "anonymizedUserRef",
        "subscriptionId",
        "planType",
        "paymentAmountXof",
        "amountXof",
        "commissionType",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "PartnerAuditLog": {
      "title": "PartnerAuditLog",
      "description": "Journal immuable des opérations administrateur sur les partenaires et règlements de commissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "enum": ["partner_created", "partner_updated", "partner_status_changed", "commission_paid"] },
        "partnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partnerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "partnerCode": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "details": { "type": "string", "minLength": 1, "maxLength": 300 },
        "amountXof": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action", "partnerId", "partnerName", "partnerCode", "actorUid", "details", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Profils et métadonnées des comptes utilisateurs (lecture/écriture propriétaire ou lecture/gestion admin)."
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/UserExpense" },
      "description": "Dépenses personnelles strictement privées accessibles uniquement à l'utilisateur propriétaire."
    },
    "/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/SubscriptionRecord" },
      "description": "Enregistrements d'abonnements et paiements pour le suivi des revenus."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRegistryEntry" },
      "description": "Liste de contrôle d'accès administrateur."
    },
    "/admin_stats/{statId}": {
      "schema": { "$ref": "#/entities/AdminStatsSnapshot" },
      "description": "Cache d'agrégation des statistiques globales administrateur et configuration."
    },
    "/partners/{partnerId}": {
      "schema": { "$ref": "#/entities/Partner" },
      "description": "Fiches complètes des partenaires publicitaires et d'affiliation (administrateurs uniquement)."
    },
    "/partner_links/{code}": {
      "schema": { "$ref": "#/entities/PartnerLink" },
      "description": "Index public minimal sans PII pour la validation des codes de parrainage par document exact."
    },
    "/partner_clicks/{clickId}": {
      "schema": { "$ref": "#/entities/PartnerClick" },
      "description": "Suivi des clics validés sur les liens de parrainage actifs."
    },
    "/referral_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ReferralSession" },
      "description": "Sessions temporaires d'attribution en base durant le parcours d'inscription."
    },
    "/partner_commissions/{commissionId}": {
      "schema": { "$ref": "#/entities/PartnerCommission" },
      "description": "Commissions uniques par utilisateur parrainé lors du premier paiement confirmé."
    },
    "/partner_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/PartnerAuditLog" },
      "description": "Historique immuable des opérations administrateur sur les partenaires et paiements."
    }
  }
}
